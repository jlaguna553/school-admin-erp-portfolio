# Copy to .env.local. Only NEXT_PUBLIC_* values reach the browser.

# Port the API is published on. The hostname is taken from window.location, so
# one build serves every school: open the app at the school's own host, e.g.
# http://northfield.localhost:3000
#
# The hostname matters for security as well as routing. The refresh token is an
# httpOnly SameSite=Lax cookie, and browsers only attach a Lax cookie to a
# same-site request. Cookies ignore ports, so northfield.localhost:3000 talking
# to northfield.localhost:8000 is same-site and the cookie is sent -- but
# localhost:3000 talking to northfield.localhost:8000 is not.
NEXT_PUBLIC_API_PORT=8000

# Absolute override for a client on a genuinely different domain (native app, or
# a local frontend against a remote API). That path gives up cookie auth and
# needs AUTH_REFRESH_IN_BODY=True on the server.
# NEXT_PUBLIC_API_ORIGIN=
