# Copy to .env and adjust. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.localhost

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgres://erp:erp@localhost:5432/erp

# CORS / frontend origin. Only needed when the frontend calls the API on a
# different origin; with the default same-origin proxy the browser never makes a
# cross-origin request.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Trust X-Forwarded-Host so the tenant resolves from the browser's hostname when
# the frontend proxies /api. Safe only behind a proxy you control.
DJANGO_USE_X_FORWARDED_HOST=True

# Refresh-token cookie. Must be True anywhere served over HTTPS (prod forces it).
AUTH_COOKIE_SECURE=False
# Also return the refresh token in the login body, for native clients only.
AUTH_REFRESH_IN_BODY=False

# JWT lifetimes (minutes / days)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
