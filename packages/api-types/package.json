{
  "name": "@erp/api-types",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript types generated from the Django API's OpenAPI 3.0 schema.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.yaml -o src/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.5.0",
    "typescript": "^5.7.2"
  }
}
